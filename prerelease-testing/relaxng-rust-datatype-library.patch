From 0cd36a60df90cf3b6bff37ecee33b877c2044cb9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 1 Sep 2026 00:49:29 +0000
Subject: [PATCH 2/2] Accept the full XSD 1.0 lexical space for xsd:anyURI

anyURI values were parsed as RFC 3986 URI references, rejecting values
with spaces or non-ASCII characters. XSD 1.0 only requires validity
after XLink-style %-escaping, so any finite string is lexically valid;
Jing accepts accordingly (TEI who="..." attributes rely on this).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Ptr1NCwEcuui4Jqaex1ffY
---
 relaxng-model/src/datatype/xsd.rs | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/relaxng-model/src/datatype/xsd.rs b/relaxng-model/src/datatype/xsd.rs
index f4cca42..4f1f83d 100644
--- a/relaxng-model/src/datatype/xsd.rs
+++ b/relaxng-model/src/datatype/xsd.rs
@@ -3,7 +3,6 @@ use crate::datatype::relax::normalize_whitespace;
 use lazy_static::lazy_static;
 use relaxng_syntax::types;
 use relaxng_syntax::types::DatatypeName;
-use std::convert::TryFrom;
 use std::fmt;
 use std::str::FromStr;
 
@@ -340,7 +339,10 @@ impl super::Datatype for XsdDatatypes {
                     && patt.as_ref().map(|p| p.1.is_match(value)).unwrap_or(true)
             }
             XsdDatatypes::AnyURI(str_facets) => {
-                uriparse::URIReference::try_from(value).is_ok() && str_facets.is_valid(value)
+                // XSD 1.0 anyURI only requires a valid URI reference after
+                // XLink-style %-escaping, so any finite string is lexically
+                // valid; Jing accepts accordingly.
+                str_facets.is_valid(value)
             }
             XsdDatatypes::Language(str_facets) => {
                 LANG_RE.is_match(value) && str_facets.is_valid(value)
@@ -2355,6 +2357,21 @@ mod test {
     use codemap::CodeMap;
     use relaxng_syntax::types;
 
